Algoritmo ProgramaFelicidad
	Definir colorDetectado Como Cadena
	Escribir 'Esperando sensor de color...'
	Leer colorDetectado
	Si colorDetectado='amarillo' Entonces
		Escribir 'Iniciando Programa Felicidad'
		Funcion2()
		Funcion3()
		Funcion1()
		Funcion4()
		Escribir 'Ejecución bloque baile'
		Escribir 'Ejecución bloque felicidad'
		Escribir 'Ejecución bloque baile 2'
		Escribir 'Ejecución bloque cabeza frente'
		Escribir 'Ejecución giro 360 grados'
		Escribir 'Fin código Felicidad'
	FinSi
FinAlgoritmo

Funcion Funcion1
	Escribir 'Giro de cabeza izquierda'
	Escribir 'Inicio voz pregrabada'
FinFuncion

Funcion Funcion2
	Escribir 'Bucle de luces LED'
FinFuncion

Funcion Funcion3
	Escribir 'Grabación de sonidos y voces pregrabadas'
FinFuncion

Funcion Funcion4
	Escribir 'Bucle doble de música'
FinFuncion
